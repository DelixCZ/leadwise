# Bundler
/.bundle

# Environment files (API keys live here if you use them — never commit)
/.env
/.env.*
!/.env*.erb

# Logs and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# SQLite databases and uploaded files
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Credentials key (do not commit)
/config/master.key
/config/credentials/*.key

# Generated CSS
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/public/assets

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.idea
.vscode
