<% bullets = lead.analysis_bullets %>
<% if bullets.any? %>
  <ul class="min-w-0 <%= local_assigns.fetch(:list_class, "space-y-2.5") %>">
    <% bullets.each do |bullet| %>
      <li class="flex min-w-0 gap-2.5 text-sm leading-relaxed text-slate-700">
        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-500"></span>
        <span class="min-w-0 flex-1 overflow-hidden break-words whitespace-normal <%= local_assigns[:clamp] ? "line-clamp-2" : "" %>"><%= bullet %></span>
      </li>
    <% end %>
  </ul>
<% elsif lead.ai_analysis.present? %>
  <p class="min-w-0 break-words whitespace-pre-wrap text-sm leading-relaxed text-slate-700"><%= lead.ai_analysis %></p>
<% else %>
  <p class="text-sm italic text-slate-400"><%= local_assigns.fetch(:empty_text, "No analysis yet") %></p>
<% end %>
