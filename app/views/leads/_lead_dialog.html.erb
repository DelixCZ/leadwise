<% auto_open = local_assigns.fetch(:open, false) %>

<div
  data-controller="dialog"
  data-dialog-auto-open-value="<%= auto_open %>"
  data-dialog-close-url-value="<%= local_assigns[:close_url] %>"
  class="inline">
  <% unless local_assigns[:hide_trigger] %>
    <button type="button" class="<%= local_assigns.fetch(:trigger_class, "font-medium text-indigo-600 hover:text-indigo-500") %>" data-action="dialog#open">
      <%= local_assigns.fetch(:trigger_label, "Open") %>
    </button>
  <% end %>

  <dialog data-dialog-target="panel" data-action="click->dialog#closeOnBackdrop" class="lead-modal">
    <div class="flex min-w-0 max-h-[min(90vh,52rem)] flex-col">
      <div class="flex shrink-0 items-start justify-between gap-4 border-b border-slate-200 bg-slate-50 px-6 py-5">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Lead profile</p>
          <h2 class="mt-1 truncate text-xl font-semibold tracking-tight text-slate-900"><%= lead.company_name %></h2>
          <%= link_to lead.website, lead.website, class: "mt-1 inline-block break-all text-sm text-indigo-600 hover:text-indigo-500", target: "_blank", rel: "noopener noreferrer" %>
        </div>
        <div class="shrink-0 text-right">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Fit score</p>
          <div class="mt-2"><%= ai_score_badge(lead.ai_score, size: :lg) %></div>
        </div>
      </div>

      <div class="min-h-0 min-w-0 flex-1 overflow-x-hidden overflow-y-auto px-6 py-6">
        <div class="grid min-w-0 gap-6 sm:grid-cols-2">
          <div class="min-w-0">
            <h3 class="text-sm font-semibold text-slate-900">Company details</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-slate-500">Company name</dt>
                <dd class="mt-0.5 font-medium text-slate-900"><%= lead.company_name %></dd>
              </div>
              <div>
                <dt class="text-slate-500">Website</dt>
                <dd class="mt-0.5 font-medium break-all text-slate-900"><%= lead.website %></dd>
              </div>
              <div>
                <dt class="text-slate-500">Added</dt>
                <dd class="mt-0.5 font-medium text-slate-900"><%= lead.created_at.strftime("%b %d, %Y") %></dd>
              </div>
            </dl>
          </div>

          <div class="min-w-0">
            <h3 class="text-sm font-semibold text-slate-900">Would they buy from you?</h3>
            <div class="mt-4 min-w-0 overflow-hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-4">
              <%= render "analysis_bullets", lead: lead, empty_text: "No AI analysis yet. Scoring will appear here once evaluation runs." %>
            </div>
            <h3 class="mt-6 text-sm font-semibold text-slate-900">Why they might not buy</h3>
            <div class="mt-4 min-w-0 overflow-hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-4">
              <% if lead.ai_objection.present? %>
                <p class="break-words text-sm leading-relaxed text-slate-700"><%= lead.ai_objection %></p>
              <% else %>
                <p class="text-sm italic text-slate-400">No objection yet. Re-evaluate this lead to generate one.</p>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="flex shrink-0 flex-col gap-3 border-t border-slate-200 bg-white px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <button type="button" data-action="dialog#showPrompt" class="text-left text-sm font-medium text-slate-600 hover:text-indigo-600">
          Show prompt
        </button>
        <div class="flex flex-wrap items-center gap-2 sm:justify-end [&_form]:inline-flex">
          <button type="button" data-action="dialog#close" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100">Close</button>
          <%= render "re_score_button", lead: lead, class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          <%= button_to "Delete lead", lead, method: :delete, class: "rounded-lg border border-rose-200 bg-white px-3 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50", form: { class: "inline-flex", data: { turbo_confirm: "Delete this lead?" } } %>
        </div>
      </div>
    </div>
  </dialog>

  <dialog data-dialog-target="prompt" data-action="click->dialog#closePromptOnBackdrop" class="lead-modal">
    <div class="flex max-h-[min(80vh,40rem)] flex-col">
      <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-5 py-3">
        <h3 class="text-sm font-semibold text-slate-900">Your company text used for this score</h3>
        <button type="button" data-action="dialog#closePrompt" class="text-sm font-medium text-slate-500 hover:text-slate-800">Close</button>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4">
        <% profile = lead.company_profile_snapshot %>
        <% if profile.present? %>
          <p class="mb-2 text-xs text-slate-500">This is the description from Your company that was sent when this lead was scored.</p>
          <pre class="whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-3 text-sm leading-relaxed text-slate-700"><%= profile %></pre>
        <% else %>
          <p class="text-sm text-slate-500">No company description was stored for this evaluation. Add one under Your company and re-evaluate this lead.</p>
        <% end %>
      </div>
    </div>
  </dialog>
</div>
