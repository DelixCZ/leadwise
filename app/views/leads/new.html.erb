<% content_for :title, "New lead · Leadwise" %>

<div class="mx-auto max-w-xl">
  <div class="mb-8">
    <%= link_to "← Back to leads", leads_path, class: "text-sm font-medium text-slate-600 hover:text-indigo-600" %>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">New lead</h1>
    <p class="mt-1 text-sm text-slate-600">Enter the company details. Creating the lead will score it with AI, which can take a few seconds.</p>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <%= render "form", lead: @lead %>
  </div>
</div>
