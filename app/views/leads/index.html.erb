<% content_for :title, "Leads · Leadwise" %>

<section class="mb-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="text-lg font-semibold tracking-tight text-slate-900">Your company</h1>
  <p class="mt-1 text-sm text-slate-600">Describe what you sell. Gemini uses this to judge whether a lead would care about your products or services.</p>

  <%= form_with model: @setting, url: setting_path, method: :patch, class: "mt-4 space-y-3" do |form| %>
    <%= form.text_area :company_description,
          rows: 5,
          placeholder: "Example: We sell warehouse automation software to mid-market logistics companies in Europe. Our product cuts picking time and integrates with SAP.",
          class: "block w-full rounded-lg border-0 px-3 py-2.5 text-sm text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-indigo-600" %>
    <div class="flex items-center justify-end">
      <%= form.submit "Save profile", class: "cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800" %>
    </div>
  <% end %>
</section>

<div class="mb-4">
  <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Leads</h2>
  <p class="mt-1 text-sm text-slate-600">Open a lead to see the fit score against your company profile.</p>
</div>

<% if @leads.any? %>
  <div class="hidden overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm md:block">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Company</th>
          <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Website</th>
          <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Fit score</th>
          <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">AI Analysis</th>
          <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @leads.each do |lead| %>
          <tr class="hover:bg-slate-50/80">
            <td class="px-6 py-4">
              <%= render "lead_dialog", lead: lead, open: @open_lead_id == lead.id, trigger_label: lead.company_name, trigger_class: "font-medium whitespace-nowrap text-slate-900 hover:text-indigo-600" %>
            </td>
            <td class="max-w-[14rem] truncate px-6 py-4 text-sm">
              <%= link_to lead.website, lead.website, class: "text-indigo-600 hover:text-indigo-500", target: "_blank", rel: "noopener noreferrer" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4">
              <%= ai_score_badge(lead.ai_score) %>
            </td>
            <td class="max-w-md px-6 py-4">
              <%= render "analysis_bullets", lead: lead, list_class: "space-y-1.5", clamp: true, empty_text: "No analysis yet" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
              <%= button_to "Delete", lead, method: :delete, class: "font-medium text-rose-600 hover:text-rose-500", form: { data: { turbo_confirm: "Delete this lead?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="grid gap-4 md:hidden">
    <% @leads.each do |lead| %>
      <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div>
            <%= render "lead_dialog", lead: lead, open: false, trigger_label: lead.company_name, trigger_class: "text-base font-semibold text-slate-900 hover:text-indigo-600" %>
            <p class="mt-1 truncate text-sm text-indigo-600"><%= lead.website %></p>
          </div>
          <%= ai_score_badge(lead.ai_score) %>
        </div>
        <div class="mt-3">
          <%= render "analysis_bullets", lead: lead, list_class: "space-y-1.5", clamp: true %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900">No leads yet</h2>
    <p class="mx-auto mt-1 max-w-md text-sm text-slate-600">Save your company profile above, then use <span class="font-medium">New Lead</span> in the header to add a prospect.</p>
  </div>
<% end %>
