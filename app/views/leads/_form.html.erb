<%= form_with model: lead,
      class: "relative space-y-6 p-6 sm:p-8",
      data: {
        controller: "loading-form",
        action: "submit->loading-form#start turbo:submit-start->loading-form#start turbo:submit-end->loading-form#stop",
        loading_form_busy_label_value: "Scoring with AI…"
      } do |form| %>
  <% if lead.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3" role="alert">
      <h2 class="text-sm font-semibold text-rose-800">
        <%= pluralize(lead.errors.count, "error") %> prevented this lead from being saved
      </h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-700">
        <% lead.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :company_name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :company_name,
          required: true,
          placeholder: "Acme Corp",
          class: "mt-1.5 block w-full rounded-lg border-0 px-3 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset placeholder:text-slate-400 focus:ring-2 focus:ring-indigo-600 #{lead.errors[:company_name].any? ? "ring-rose-400 focus:ring-rose-500" : "ring-slate-300"}" %>
    <% if lead.errors[:company_name].any? %>
      <p class="mt-1.5 text-sm text-rose-600"><%= lead.errors[:company_name].to_sentence %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :website, class: "block text-sm font-medium text-slate-700" %>
    <%= form.url_field :website,
          required: true,
          placeholder: "https://example.com",
          class: "mt-1.5 block w-full rounded-lg border-0 px-3 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset placeholder:text-slate-400 focus:ring-2 focus:ring-indigo-600 #{lead.errors[:website].any? ? "ring-rose-400 focus:ring-rose-500" : "ring-slate-300"}" %>
    <% if lead.errors[:website].any? %>
      <p class="mt-1.5 text-sm text-rose-600"><%= lead.errors[:website].to_sentence %></p>
    <% end %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Cancel", leads_path, class: "rounded-lg px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
    <%= form.button type: :submit,
          name: nil,
          class: "inline-flex cursor-pointer items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-wait disabled:opacity-90",
          data: { loading_form_target: "submit" } do %>
      <span class="hidden" data-loading-form-target="spinner">
        <%= render "loading_spinner" %>
      </span>
      <span data-loading-form-target="label">Create lead</span>
    <% end %>
  </div>

  <div hidden data-loading-form-target="overlay" class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 rounded-xl bg-white/85 backdrop-blur-[2px]" role="status" aria-live="polite">
    <span class="text-indigo-600">
      <%= render "loading_spinner", size: "h-8 w-8" %>
    </span>
    <p class="text-sm font-semibold text-slate-900">Scoring this lead with AI</p>
    <p class="text-xs text-slate-500">This usually takes a few seconds.</p>
  </div>
<% end %>
